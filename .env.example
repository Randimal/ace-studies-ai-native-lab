# Ace Studies AI-Native Lab — API key template
# Copy this file to .env and fill in only the providers you plan to use.
# Keep real keys in .env, never in this example or in Git commits.
# .env is excluded from Git by this project's .gitignore.
#
# The app reads .env in the project root. It never loads .env.example directly.
# Priority: UI override > process environment > .env > built-in defaults.
# Blank API-key override fields use the selected provider's default key.
# Clear session reloads UI setting defaults and removes typed overrides, but
# default keys remain available. Restart the app after changing process variables.
# Provider-sharing consent is still required. Default keys are shared server
# configuration: this application is intended for local use.

# Generation provider: OpenAI, Google Gemini, Groq, Anthropic, or OpenRouter.
LLM_PROVIDER=OpenAI
# Enter an exact generation model ID available in your chosen provider account.
# This default is applied only to LLM_PROVIDER, not to other provider selections.
LLM_MODEL=

# Retrieval: lexical or semantic.
# lexical matches words without embedding API calls.
# semantic uses an embedding API and the local Chroma vector database.
RETRIEVAL_MODE=semantic

# Embedding provider: OpenAI, Google Gemini, or OpenRouter (independent of LLM_PROVIDER).
EMBEDDING_PROVIDER=OpenAI
# Example for OpenAI; for Google Gemini, use a compatible Gemini embedding model.
EMBEDDING_MODEL=text-embedding-3-small
# Embeddings use the corresponding provider key below.

# OpenAI — generation and/or embeddings
OPENAI_API_KEY=

# Google Gemini — generation and/or embeddings
GOOGLE_API_KEY=

# Groq — generation (a different service from xAI Grok)
GROQ_API_KEY=

# Anthropic — generation
ANTHROPIC_API_KEY=

# OpenRouter — generation and/or embeddings
# Generation example: LLM_PROVIDER=OpenRouter and LLM_MODEL=openrouter/free
# Embedding example: EMBEDDING_PROVIDER=OpenRouter
# EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b:free
# Free models have usage limits and provider-specific data-use terms.
# Other model IDs may be paid. Check current model pricing before use.
OPENROUTER_API_KEY=
